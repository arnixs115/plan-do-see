# 이 파일을 복사해서 .env.local을 만들고 값을 채운다. (.env.local은 Git에 올리지 않는다)
#   cp .env.example .env.local

# Supabase 프로젝트 URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# 서버 전용 비밀 키. 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# 브라우저에 노출되면 DB 전체 접근 권한이 노출된다.
SUPABASE_SECRET_KEY=

# 브라우저용 공개 키 (Project Settings > API Keys 의 publishable key).
# 로그인(Supabase Auth)에 쓰며, 공개되도록 만들어진 키라 NEXT_PUBLIC_ 이 붙는다.
# 비밀 키(SUPABASE_SECRET_KEY)와 혼동하지 않는다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 패스키(WebAuthn). 개발 중에는 비워 두면 http://localhost:3000 / localhost 를 쓴다.
# 배포(production)에서는 두 값을 반드시 지정한다. RP ID 는 패스키가 묶이는 도메인이라 나중에 바꾸면 기존 패스키를 쓸 수 없다.
#   WEBAUTHN_ORIGIN : 브라우저 주소창의 origin (https://, 끝에 / 없음)
#   WEBAUTHN_RP_ID  : 도메인만 (https:// 와 경로 없음). origin 의 호스트와 같거나 그 상위 도메인
#   WEBAUTHN_RP_NAME: 패스키 선택 창에 보일 서비스 이름(선택)
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
