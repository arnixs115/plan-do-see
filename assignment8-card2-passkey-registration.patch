diff --git a/db/checks/passkey-registration.sql b/db/checks/passkey-registration.sql
new file mode 100644
index 0000000..f99e1d2
--- /dev/null
+++ b/db/checks/passkey-registration.sql
@@ -0,0 +1,50 @@
+-- 패스키 등록 점검 SQL (과제 8 카드 2). 읽기 전용(SELECT만). Supabase 대시보드 > SQL Editor에서 실행한다.
+--
+-- 이 파일은 공개 키·credential_id·챌린지 값 자체를 출력하지 않는다. 길이·개수·true/false·모델 식별값(aaguid)만 낸다.
+-- (공개 키는 비밀이 아니지만, 화면 캡처에 긴 값이 섞이지 않게 하려는 것이다.)
+
+-- 1) 표가 있고 열이 의도한 것뿐인가
+select table_name, column_name, data_type
+from information_schema.columns
+where table_schema = 'public'
+  and table_name in ('passkey_credentials', 'passkey_registration_challenges')
+order by table_name, ordinal_position;
+
+-- 2) 개인 키·비밀값을 담을 만한 열이 없는가 (결과가 0행이어야 한다)
+select table_name, column_name
+from information_schema.columns
+where table_schema = 'public'
+  and table_name in ('passkey_credentials', 'passkey_registration_challenges')
+  and column_name ~* '(private|secret|priv_|password)';
+
+-- 3) 브라우저용 키(anon, authenticated)로는 접근할 수 없는가 (모두 false 여야 한다)
+select
+  has_table_privilege('anon', 'public.passkey_credentials', 'select')                  as anon_select_credentials,
+  has_table_privilege('authenticated', 'public.passkey_credentials', 'select')         as auth_select_credentials,
+  has_table_privilege('anon', 'public.passkey_registration_challenges', 'select')      as anon_select_challenges,
+  has_table_privilege('authenticated', 'public.passkey_registration_challenges', 'select') as auth_select_challenges,
+  has_function_privilege('anon', 'public.consume_registration_challenge(uuid, uuid)', 'execute')   as anon_exec_consume,
+  has_function_privilege('authenticated', 'public.create_registration_challenge(uuid, text, text)', 'execute') as auth_exec_create;
+
+-- 4) 등록된 패스키 현황 (값 자체는 출력하지 않는다)
+select
+  count(*)                                   as passkeys,
+  count(distinct user_id)                    as users,
+  count(distinct credential_id)              as distinct_credential_ids,   -- passkeys 와 같아야 한다(중복 없음)
+  min(char_length(public_key))               as public_key_len_min,
+  max(char_length(public_key))               as public_key_len_max,
+  count(*) filter (where counter < 0)        as bad_counter
+from public.passkey_credentials;
+
+-- 5) 모델 식별값(aaguid)별 개수. 제공자를 단정하려면 이 값을 공개 목록(passkeydeveloper/passkey-authenticator-aaguids)에서 직접 찾아 대조한다.
+select coalesce(aaguid, '(없음)') as aaguid, device_type, backed_up, count(*) as passkeys
+from public.passkey_credentials
+group by 1, 2, 3
+order by passkeys desc;
+
+-- 6) 챌린지 상태: 대기 중 / 사용됨 / 만료됨
+select
+  count(*) filter (where consumed_at is null and expires_at > now())  as pending,
+  count(*) filter (where consumed_at is not null)                     as consumed,
+  count(*) filter (where consumed_at is null and expires_at <= now()) as expired_unused
+from public.passkey_registration_challenges;
diff --git a/db/migrations/20261030100000_add_passkeys.sql b/db/migrations/20261030100000_add_passkeys.sql
new file mode 100644
index 0000000..27bd0c4
--- /dev/null
+++ b/db/migrations/20261030100000_add_passkeys.sql
@@ -0,0 +1,95 @@
+-- 과제 8 카드 2: 패스키(WebAuthn) 등록용 표와 함수 (추가만)
+--
+--  * 기존 표·함수는 건드리지 않는다. (create 만 있고 drop·alter 는 없다)
+--  * passkey_credentials              : 등록이 끝난 패스키. credential_id 와 공개 키(public_key)만 저장한다.
+--                                       개인 키는 사용자의 기기·패스키 제공자에 남고 서버로 오지 않는다. 그래서 저장할 개인 키 열이 아예 없다.
+--  * passkey_registration_challenges  : 등록을 시작할 때 서버가 만든 1회용 챌린지.
+--                                       서버리스에서는 요청마다 다른 인스턴스가 받을 수 있어 서버 메모리 대신 DB에 둔다.
+--                                       만료(expires_at)와 소비(consumed_at)를 함께 관리하고, 사용자·이름과 묶어 둔다.
+--  * 두 표 모두 사용자가 지워지면 함께 지워진다. (on delete cascade → 계정 삭제 때 패스키와 챌린지도 삭제)
+--  * 챌린지의 생성과 소비는 함수로 한다. 시간은 서버 시계가 아니라 DB의 now()로 판단하고,
+--    소비는 UPDATE 한 문장이라 같은 챌린지로 동시에 요청해도 한 요청만 성공한다.
+--  * 기존 표들과 같이: RLS 활성화, anon/authenticated 권한 없음(서버 service_role만 접근)
+
+create table public.passkey_credentials (
+  id            uuid        primary key default gen_random_uuid(),
+  user_id       uuid        not null references auth.users (id) on delete cascade,
+  credential_id text        not null,                  -- base64url. 같은 인증기·같은 서비스에서 고유한 값
+  public_key    text        not null,                  -- COSE 공개 키(base64url). 공개 키이며 개인 키가 아니다
+  counter       bigint      not null default 0,        -- 서명 카운터 (카드 3의 로그인 검증에서 쓴다)
+  transports    text[]      not null default '{}',     -- 인증기가 알려 준 연결 방식(usb, nfc, hybrid, internal ...)
+  device_type   text        not null,                  -- singleDevice(한 기기에 묶임) / multiDevice(동기화 가능)
+  backed_up     boolean     not null,                  -- 지금 백업·동기화되어 있는지(등록 시점의 값)
+  aaguid        text,                                  -- 인증기 모델 식별값. 제공자를 단정하는 근거가 아니라 참고값이다
+  name          text        not null,                  -- 사용자가 붙인 표시용 이름. 인증 증거로 쓰지 않는다
+  created_at    timestamptz not null default now(),
+  last_used_at  timestamptz,
+  constraint passkey_credentials_credential_id_key unique (credential_id),
+  constraint passkey_credentials_credential_id_check check (char_length(credential_id) > 0),
+  constraint passkey_credentials_public_key_check check (char_length(public_key) > 0),
+  constraint passkey_credentials_counter_check check (counter >= 0),
+  constraint passkey_credentials_device_type_check check (device_type in ('singleDevice', 'multiDevice')),
+  constraint passkey_credentials_name_check check (char_length(btrim(name)) between 1 and 40)
+);
+
+create index passkey_credentials_user_id_idx on public.passkey_credentials (user_id);
+
+create table public.passkey_registration_challenges (
+  id           uuid        primary key default gen_random_uuid(),
+  user_id      uuid        not null references auth.users (id) on delete cascade,
+  challenge    text        not null,                   -- base64url. 서버가 만든 예측하기 어려운 값
+  pending_name text        not null,                   -- 이 등록에서 쓸 표시 이름. 검증 단계에서는 클라이언트가 보낸 이름을 쓰지 않는다
+  created_at   timestamptz not null default now(),
+  expires_at   timestamptz not null default (now() + interval '5 minutes'),
+  consumed_at  timestamptz,
+  constraint passkey_registration_challenges_challenge_key unique (challenge),
+  constraint passkey_registration_challenges_name_check check (char_length(btrim(pending_name)) between 1 and 40)
+);
+
+create index passkey_registration_challenges_user_id_idx on public.passkey_registration_challenges (user_id);
+
+alter table public.passkey_credentials enable row level security;
+alter table public.passkey_registration_challenges enable row level security;
+
+revoke all on table public.passkey_credentials from anon, authenticated;
+revoke all on table public.passkey_registration_challenges from anon, authenticated;
+
+grant select, insert, update, delete on table public.passkey_credentials to service_role;
+grant select, insert, update, delete on table public.passkey_registration_challenges to service_role;
+
+-- 챌린지 만들기: 이 사용자의 오래된(만료 1시간 지난) 챌린지를 정리하고 새 챌린지를 넣는다.
+create function public.create_registration_challenge(p_user_id uuid, p_challenge text, p_name text)
+returns table (challenge_id uuid, challenge_expires_at timestamptz)
+language sql
+set search_path = ''
+as $$
+  with purge as (
+    delete from public.passkey_registration_challenges
+     where user_id = p_user_id
+       and expires_at < now() - interval '1 hour'
+  )
+  insert into public.passkey_registration_challenges (user_id, challenge, pending_name)
+  values (p_user_id, p_challenge, p_name)
+  returning id, expires_at;
+$$;
+
+-- 챌린지 소비: 이 사용자의 것이고, 아직 쓰이지 않았고, 만료되지 않았을 때만 "쓴 것"으로 표시하고 내용을 돌려준다.
+-- 조건에 맞는 행이 없으면(없는 id, 남의 것, 이미 씀, 만료) 빈 결과다. 이유는 구분하지 않는다.
+create function public.consume_registration_challenge(p_challenge_id uuid, p_user_id uuid)
+returns table (challenge_value text, credential_name text)
+language sql
+set search_path = ''
+as $$
+  update public.passkey_registration_challenges c
+     set consumed_at = now()
+   where c.id = p_challenge_id
+     and c.user_id = p_user_id
+     and c.consumed_at is null
+     and c.expires_at > now()
+  returning c.challenge, c.pending_name;
+$$;
+
+revoke execute on function public.create_registration_challenge(uuid, text, text) from public, anon, authenticated;
+revoke execute on function public.consume_registration_challenge(uuid, uuid) from public, anon, authenticated;
+grant execute on function public.create_registration_challenge(uuid, text, text) to service_role;
+grant execute on function public.consume_registration_challenge(uuid, uuid) to service_role;
diff --git a/docs/passkey-registration.md b/docs/passkey-registration.md
new file mode 100644
index 0000000..a973ff8
--- /dev/null
+++ b/docs/passkey-registration.md
@@ -0,0 +1,67 @@
+# 패스키 등록 (과제 8 카드 2)
+
+로그인한 사용자가 **계정 화면(`/account`)** 에서 패스키를 등록한다. 서버에는 **공개 키와 credential ID**만 저장된다. 패스키로 로그인(카드 3)과 삭제(카드 4)는 아직 없다.
+
+## 구성
+
+| 항목 | 내용 |
+| --- | --- |
+| 라이브러리 | `@simplewebauthn/server` 14.0.3, `@simplewebauthn/browser` 14.0.0 |
+| 등록 대상 | 항상 로그인한 사용자(`requireUser`). 요청에서 사용자 id·이메일을 받지 않는다 |
+| 인증기 요구 | `residentKey: required`, `userVerification: required`, `attestationType: none` |
+| 저장 | `passkey_credentials`(공개 키 등), `passkey_registration_challenges`(일회용 챌린지) — `db/migrations/20261030100000_add_passkeys.sql` |
+
+## API
+
+| 경로 | 역할 |
+| --- | --- |
+| `GET /api/passkeys` | 내 패스키 목록(이름, 등록·마지막 사용 일시, 기기 종류, AAGUID, transports). credential ID·공개 키·카운터는 내보내지 않는다 |
+| `POST /api/passkeys/register/options` | 본문 `{name}`. 새 챌린지를 만들어 DB에 저장하고 `{challenge_id, expires_at, options}` 반환 |
+| `POST /api/passkeys/register/verify` | 본문 `{challenge_id, response}`. 챌린지 소비 → 라이브러리 검증 → 통과 시에만 저장(201) |
+
+## 챌린지
+
+- 요청마다 라이브러리가 새 값을 만든다(32바이트 난수). 서버리스에서 인스턴스가 바뀌어도 쓸 수 있게 **메모리가 아니라 DB**에 둔다.
+- 행에는 사용자, 표시 이름, 만료 시각(DB 시계 기준 5분), 소비 시각이 묶인다.
+- verify 는 **먼저** 챌린지를 소비한다: `UPDATE … WHERE id=… AND user_id=… AND consumed_at IS NULL AND expires_at > now() RETURNING` 한 문장(`consume_registration_challenge`). 동시에 여러 요청이 와도 한 요청만 값을 받는다.
+- 소비된 뒤에는 검증이 실패해도 같은 챌린지를 다시 쓸 수 없다. 다시 하려면 등록을 처음부터 시작한다.
+- 없는 id·남의 챌린지·사용·만료는 모두 같은 400 으로 답한다(이유를 구분해 알려 주지 않는다).
+
+## 서버 검증
+
+`verifyRegistrationResponse` 에 기대 챌린지, `expectedOrigin`, `expectedRPID`, `requireUserPresence`, `requireUserVerification` 을 넘긴다. 실패하면 저장하지 않는다. `credential_id` 는 DB 고유 제약이 중복(다른 계정 포함)을 막고 409 로 답한다.
+
+## 환경 변수
+
+| 변수 | 개발 | 배포 |
+| --- | --- | --- |
+| `WEBAUTHN_ORIGIN` | 비우면 `http://localhost:3000` | 예: `https://plan-do-see-silk.vercel.app` (필수) |
+| `WEBAUTHN_RP_ID` | 비우면 `localhost` | 예: `plan-do-see-silk.vercel.app` (필수) |
+| `WEBAUTHN_RP_NAME` | 선택 | 선택 |
+
+RP ID 는 패스키가 묶이는 도메인이다. **나중에 바꾸면 이미 만든 패스키를 쓸 수 없다.** Vercel 의 프리뷰 주소처럼 origin 이 다른 곳에서는 등록이 거부된다.
+
+## DB 적용
+
+저장소는 마이그레이션 파일만 기록한다. Supabase SQL Editor 에서 `db/migrations/20261030100000_add_passkeys.sql` 을 실행한 뒤 `db/checks/passkey-registration.sql` 로 확인한다. 기존 표는 건드리지 않는다. 마이그레이션 전에도 계정 화면은 열리며 패스키 구역에 안내 문구가 나온다.
+
+## 어떤 제공자로 만들어졌는지 확인하는 방법
+
+- 패스키 선택 창(브라우저·OS가 띄움)에 보이는 이름이 1차 단서다. 크롬은 "Google 비밀번호 관리자", 윈도우는 "Windows Hello", macOS/iOS는 "iCloud 키체인", 보안 키는 "USB 보안 키" 등으로 표시한다.
+- 서버에는 AAGUID(인증기 모델 식별값), `device_type`(singleDevice/multiDevice), `backed_up`, `transports` 가 저장된다. `db/checks/passkey-registration.sql` 이 AAGUID 별 개수를 보여 준다.
+- AAGUID 를 공개 목록(예: passkeydeveloper/passkey-authenticator-aaguids)에서 찾으면 제공자 이름을 알 수 있다. 목록에 없거나 `00000000-0000-0000-0000-000000000000` 이면 **제공자를 알 수 없다**고 보아야 한다(일부 제공자는 0으로 숨긴다). `attestationType: none` 이므로 제공자가 증명된 값은 아니다.
+- 크롬 설정 > 자동 완성 및 비밀번호 > Google 비밀번호 관리자 > 패스키, 또는 OS의 패스키/비밀번호 앱에서 이 사이트의 패스키가 보이는지 직접 확인한다.
+
+## 직접 확인하는 절차 (실제 브라우저·제공자)
+
+1. 마이그레이션 적용 + Vercel 환경 변수 두 개 설정 + 재배포.
+2. HTTPS 주소로 로그인 → `/account` → "패스키 이름" 입력 → "패스키 등록".
+3. 브라우저/OS 창에서 지문·PIN 등으로 확인. 성공 문구와 목록에 이름·등록 일시가 나오는지 본다.
+4. 창에서 **취소** → 취소 안내가 나오고 목록이 그대로인지 본다.
+5. 새로고침해도 목록이 유지되는지, 다른 계정으로 로그인하면 목록이 비어 있는지 본다.
+6. SQL Editor 에서 `db/checks/passkey-registration.sql` 실행(개수와 공개 키 길이만 나오고 키 값은 출력하지 않는다).
+7. 스크린샷·로그에 쿠키, 토큰, `SUPABASE_SECRET_KEY` 가 보이지 않게 한다(개발자 도구 Network 탭의 요청 헤더 캡처 금지).
+
+## 이 카드에서 하지 않은 것
+
+패스키 로그인·로그아웃(카드 3), 패스키 삭제(카드 4), 두 패스키를 이용한 검증, 패스키 추가 시 최근 로그인 재확인.
