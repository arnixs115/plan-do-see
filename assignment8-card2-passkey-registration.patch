diff --git a/app/account/passkey-section.tsx b/app/account/passkey-section.tsx
new file mode 100644
index 0000000..4016c84
--- /dev/null
+++ b/app/account/passkey-section.tsx
@@ -0,0 +1,159 @@
+"use client";
+
+import { useState } from "react";
+import { startRegistration } from "@simplewebauthn/browser";
+import { api, ApiError } from "@/lib/api-client";
+import { inputClass, primaryButton } from "@/app/ui-classes";
+import type { PasskeyView } from "@/lib/passkeys/types";
+
+type Props = {
+  initialPasskeys: PasskeyView[];
+  // 서버가 목록을 읽지 못했을 때(예: 마이그레이션 미적용) 보여 줄 안내
+  loadError: string | null;
+};
+
+type Status = "idle" | "preparing" | "waiting" | "saving";
+
+const STATUS_TEXT: Record<Exclude<Status, "idle">, string> = {
+  preparing: "서버에서 등록 요청을 준비하는 중…",
+  waiting: "브라우저의 패스키 창에서 안내를 따라 주세요…",
+  saving: "서버가 등록 결과를 확인하는 중…",
+};
+
+function formatDate(iso: string): string {
+  return new Date(iso).toLocaleString("ko-KR", { dateStyle: "medium", timeStyle: "short" });
+}
+
+function browserErrorMessage(error: unknown): string {
+  const name = error instanceof Error ? error.name : "";
+
+  if (name === "NotAllowedError" || name === "AbortError") {
+    return "패스키 등록이 취소되었거나 시간이 지났습니다. 저장된 것은 없습니다.";
+  }
+
+  if (name === "InvalidStateError") {
+    return "이 기기(또는 패스키 제공자)에는 이 계정의 패스키가 이미 있습니다. 저장된 것은 없습니다.";
+  }
+
+  if (name === "NotSupportedError" || name === "SecurityError") {
+    return "이 브라우저나 주소에서는 패스키를 만들 수 없습니다. HTTPS 주소와 최신 브라우저인지 확인하세요.";
+  }
+
+  return "패스키를 만들지 못했습니다. 저장된 것은 없습니다.";
+}
+
+export default function PasskeySection({ initialPasskeys, loadError }: Props) {
+  const [passkeys, setPasskeys] = useState(initialPasskeys);
+  const [name, setName] = useState("");
+  const [status, setStatus] = useState<Status>("idle");
+  const [message, setMessage] = useState<{ kind: "ok" | "error"; text: string } | null>(null);
+
+  const busy = status !== "idle";
+
+  async function onSubmit(event: React.FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    setMessage(null);
+
+    if (typeof window === "undefined" || !window.PublicKeyCredential) {
+      setMessage({ kind: "error", text: "이 브라우저는 패스키를 지원하지 않습니다." });
+      return;
+    }
+
+    try {
+      setStatus("preparing");
+
+      const started = await api<{ challenge_id: string; options: Parameters<typeof startRegistration>[0]["optionsJSON"] }>(
+        "/api/passkeys/register/options",
+        { method: "POST", body: JSON.stringify({ name }) }
+      );
+
+      setStatus("waiting");
+
+      // 개인 키는 브라우저/패스키 제공자 안에서 만들어지고 밖으로 나오지 않는다. 여기서 받는 결과에는 공개 키와 서명만 있다.
+      let credential;
+
+      try {
+        credential = await startRegistration({ optionsJSON: started.options });
+      } catch (caught) {
+        setMessage({ kind: "error", text: browserErrorMessage(caught) });
+        return;
+      }
+
+      setStatus("saving");
+
+      const saved = await api<{ passkey: PasskeyView }>("/api/passkeys/register/verify", {
+        method: "POST",
+        body: JSON.stringify({ challenge_id: started.challenge_id, response: credential }),
+      });
+
+      setPasskeys((current) => [...current, saved.passkey]);
+      setName("");
+      setMessage({ kind: "ok", text: `패스키 "${saved.passkey.name}"을(를) 등록했습니다.` });
+    } catch (caught) {
+      setMessage({
+        kind: "error",
+        text: caught instanceof ApiError ? caught.message : "패스키를 등록하지 못했습니다.",
+      });
+    } finally {
+      setStatus("idle");
+    }
+  }
+
+  return (
+    <section className="mt-8 rounded-md border border-line bg-surface p-5">
+      <h2 className="text-lg font-semibold">패스키</h2>
+      <p className="mt-2 text-sm text-muted">
+        이 기기나 패스키 제공자에 패스키를 만듭니다. 개인 키는 내 기기(또는 제공자)에만 남고 서버에는 공개 키만 저장됩니다.
+        이름은 목록에서 구분하기 위한 표시용입니다.
+      </p>
+
+      <form onSubmit={onSubmit} className="mt-4 space-y-3" noValidate>
+        <label className="block text-sm">
+          <span className="mb-1 block font-medium">패스키 이름</span>
+          <input
+            type="text"
+            maxLength={40}
+            autoComplete="off"
+            placeholder="예: 내 노트북"
+            value={name}
+            onChange={(event) => setName(event.target.value)}
+            className={inputClass}
+          />
+        </label>
+
+        <button type="submit" disabled={busy || name.trim() === ""} className={primaryButton}>
+          {busy ? "진행 중…" : "패스키 등록"}
+        </button>
+
+        <p role="status" aria-live="polite" className="min-h-5 text-sm text-muted">
+          {status !== "idle" ? STATUS_TEXT[status] : ""}
+        </p>
+
+        {message && (
+          <p role={message.kind === "error" ? "alert" : "status"} className={`text-sm ${message.kind === "error" ? "text-danger" : ""}`}>
+            {message.text}
+          </p>
+        )}
+      </form>
+
+      <h3 className="mt-6 text-sm font-semibold">등록된 패스키</h3>
+
+      {loadError ? (
+        <p role="alert" className="mt-2 text-sm text-danger">
+          {loadError}
+        </p>
+      ) : passkeys.length === 0 ? (
+        <p className="mt-2 text-sm text-muted">아직 등록한 패스키가 없습니다.</p>
+      ) : (
+        <ul className="mt-2 divide-y divide-line text-sm">
+          {passkeys.map((passkey) => (
+            <li key={passkey.id} className="py-2">
+              <span className="font-medium break-all">{passkey.name}</span>
+              <span className="block text-muted">등록: {formatDate(passkey.created_at)}</span>
+            </li>
+          ))}
+        </ul>
+      )}
+    </section>
+  );
+}
diff --git a/app/api/passkeys/register/options/route.ts b/app/api/passkeys/register/options/route.ts
new file mode 100644
index 0000000..4c476bc
--- /dev/null
+++ b/app/api/passkeys/register/options/route.ts
@@ -0,0 +1,90 @@
+import { NextResponse } from "next/server";
+import { generateRegistrationOptions } from "@simplewebauthn/server";
+import { requireUser } from "@/lib/auth/require-user";
+import { dbErrorResponse, errorResponse, readJsonObject } from "@/lib/api-utils";
+import { getWebAuthnConfig } from "@/lib/passkeys/config";
+import { createRegistrationChallenge, listCredentialRefs } from "@/lib/passkeys/store";
+import {
+  MAX_PASSKEYS_PER_USER,
+  REGISTRATION_TIMEOUT_MS,
+  normalizePasskeyName,
+  originHeaderAllowed,
+} from "@/lib/passkeys/validation";
+
+// POST: 패스키 등록을 시작한다. 서버가 새 챌린지를 만들어 DB에 저장하고, 브라우저가 쓸 등록 옵션을 돌려준다.
+//
+//  * 요청 본문: { "name": "<패스키 표시 이름>" }
+//  * 등록 대상 사용자는 항상 로그인한 사용자다. 요청에서 사용자 id 나 이메일을 받지 않는다.
+//    (임의의 사용자 id 를 넣어서 다른 사람 계정에 패스키를 등록하는 일이 없도록)
+//  * 챌린지는 요청마다 새로 만든다. DB에는 사용자·표시 이름·만료 시각(5분)과 함께 저장되고, 응답의 challenge_id 로 가리킨다.
+//  * 이미 등록한 패스키는 excludeCredentials 로 알려서, 같은 인증기에 같은 계정의 패스키를 또 만들지 못하게 한다.
+//  * 발급 응답에는 개인 키 관련 값이 없다. (개인 키는 브라우저가 패스키 제공자 안에서 만든다)
+//  * residentKey·userVerification 을 required 로 요구한다. 다음 카드의 "아이디 입력 없이 패스키로 로그인"에 필요하다.
+export async function POST(request: Request) {
+  const auth = await requireUser(request);
+  if (!auth.ok) return auth.response;
+
+  const configured = getWebAuthnConfig();
+
+  if (!configured.ok) {
+    console.error("POST /api/passkeys/register/options: 패스키 설정 오류:", configured.reason);
+    return errorResponse("패스키 설정이 되어 있지 않아 지금은 등록할 수 없습니다.", 503);
+  }
+
+  const { rpID, origin, rpName } = configured.config;
+
+  if (!originHeaderAllowed(request.headers.get("origin"), origin)) {
+    return errorResponse("허용되지 않은 요청 주소입니다.", 403);
+  }
+
+  const parsed = await readJsonObject(request);
+
+  if (!parsed.ok) {
+    return parsed.response;
+  }
+
+  const named = normalizePasskeyName(parsed.body.name);
+
+  if (!named.ok) {
+    return errorResponse(named.error, 400);
+  }
+
+  const existing = await listCredentialRefs(auth.user.id);
+
+  if (existing.error || !existing.data) {
+    return dbErrorResponse(existing.error ?? {}, "POST /api/passkeys/register/options");
+  }
+
+  if (existing.data.length >= MAX_PASSKEYS_PER_USER) {
+    return errorResponse(`패스키는 한 계정에 최대 ${MAX_PASSKEYS_PER_USER}개까지 등록할 수 있습니다.`, 409);
+  }
+
+  const accountLabel = auth.user.email ?? "내 계정";
+
+  const options = await generateRegistrationOptions({
+    rpName,
+    rpID,
+    // 패스키 선택 창에 보이는 계정 이름. 사용자 핸들(userID)은 이메일이 아니라 변하지 않는 계정 id 를 쓴다.
+    userName: accountLabel,
+    userDisplayName: accountLabel,
+    userID: new TextEncoder().encode(auth.user.id),
+    attestationType: "none",
+    timeout: REGISTRATION_TIMEOUT_MS,
+    excludeCredentials: existing.data.map((credential) => ({
+      id: credential.credential_id,
+      transports: credential.transports,
+    })),
+    authenticatorSelection: { residentKey: "required", userVerification: "required" },
+  });
+
+  const created = await createRegistrationChallenge(auth.user.id, options.challenge, named.name);
+
+  if (created.error || !created.data) {
+    return dbErrorResponse(created.error ?? {}, "POST /api/passkeys/register/options");
+  }
+
+  return NextResponse.json(
+    { challenge_id: created.data.challenge_id, expires_at: created.data.expires_at, options },
+    { headers: { "Cache-Control": "no-store" } }
+  );
+}
