@@ -0,0 +1,69 @@
+// 패스키(WebAuthn) 서버 설정: RP ID(서비스 도메인), origin(주소), 화면에 보일 서비스 이름.
+// 다른 파일을 import하지 않는 순수 함수만 둔다. (Node의 test runner로 바로 시험할 수 있게 하려는 것: scripts/passkey-validation.test.mjs)
+//
+//  * 값은 환경변수로 받는다. 요청의 Host 헤더에서 만들지 않는다. (요청이 보내 주는 값으로 "내 주소"를 정하면 검증의 의미가 없다)
+//      WEBAUTHN_ORIGIN   : 브라우저 주소창의 origin. 예) https://plan-do-see-silk.vercel.app , 로컬은 http://localhost:3000
+//      WEBAUTHN_RP_ID    : 도메인만. 스킴·포트·경로 없음. 예) plan-do-see-silk.vercel.app , 로컬은 localhost
+//      WEBAUTHN_RP_NAME  : (선택) 패스키 창에 보일 이름
+//  * RP ID는 패스키가 묶이는 도메인이다. 나중에 바꾸면 이미 등록한 패스키로 로그인할 수 없게 되므로 처음에 정확히 정한다.
+//  * 개발 환경(NODE_ENV 가 production 이 아님)에서만 localhost:3000 기본값을 쓴다.
+//    배포(production)에서 값이 없으면 기본값으로 조용히 동작하지 않고, 설정 오류로 처리한다.
+
+export type WebAuthnConfig = { rpID: string; origin: string; rpName: string };
+
+export type WebAuthnConfigResult =
+  | { ok: true; config: WebAuthnConfig }
+  | { ok: false; reason: string };
+
+const DEV_ORIGIN = "http://localhost:3000";
+const DEV_RP_ID = "localhost";
+const DEFAULT_RP_NAME = "Plan-Do-See Diary";
+
+const DOMAIN_PATTERN = /^(?=.{1,253}$)[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$/;
+const IPV4_PATTERN = /^\d{1,3}(\.\d{1,3}){3}$/;
+
+export function parseWebAuthnConfig(
+  env: Record<string, string | undefined>,
+  production: boolean
+): WebAuthnConfigResult {
+  const rawOrigin = env.WEBAUTHN_ORIGIN?.trim() || (production ? "" : DEV_ORIGIN);
+  const rawRpId = env.WEBAUTHN_RP_ID?.trim().toLowerCase() || (production ? "" : DEV_RP_ID);
+  const rpName = env.WEBAUTHN_RP_NAME?.trim() || DEFAULT_RP_NAME;
+
+  if (!rawOrigin || !rawRpId) {
+    return { ok: false, reason: "WEBAUTHN_ORIGIN 과 WEBAUTHN_RP_ID 환경변수가 설정되지 않았습니다." };
+  }
+
+  let url: URL;
+
+  try {
+    url = new URL(rawOrigin);
+  } catch {
+    return { ok: false, reason: "WEBAUTHN_ORIGIN 이 올바른 주소가 아닙니다." };
+  }
+
+  // 끝의 "/" 나 경로가 붙은 값은 브라우저가 보내는 origin 과 문자열이 달라서 항상 검증에 실패한다.
+  if (url.origin !== rawOrigin) {
+    return { ok: false, reason: "WEBAUTHN_ORIGIN 은 경로 없이 스킴+호스트(+포트)만 적어야 합니다. 예) https://example.com" };
+  }
+
+  const isLocalhost = url.hostname === "localhost";
+
+  if (url.protocol !== "https:" && !(url.protocol === "http:" && isLocalhost)) {
+    return { ok: false, reason: "WEBAUTHN_ORIGIN 은 https 여야 합니다. (http 는 localhost 만 허용)" };
+  }
+
+  if (IPV4_PATTERN.test(rawRpId) || !DOMAIN_PATTERN.test(rawRpId)) {
+    return { ok: false, reason: "WEBAUTHN_RP_ID 는 스킴·포트·경로 없는 도메인이어야 합니다. 예) example.com" };
+  }
+
+  if (!(url.hostname === rawRpId || url.hostname.endsWith(`.${rawRpId}`))) {
+    return { ok: false, reason: "WEBAUTHN_RP_ID 가 WEBAUTHN_ORIGIN 의 호스트와 같거나 그 상위 도메인이어야 합니다." };
+  }
+
+  return { ok: true, config: { rpID: rawRpId, origin: rawOrigin, rpName } };
+}
+
+export function getWebAuthnConfig(): WebAuthnConfigResult {
+  return parseWebAuthnConfig(process.env, process.env.NODE_ENV === "production");
+}
diff --git a/lib/passkeys/store.ts b/lib/passkeys/store.ts
new file mode 100644
index 0000000..a89cf5a
--- /dev/null
+++ b/lib/passkeys/store.ts
@@ -0,0 +1,107 @@
+import "server-only";
+import { getSupabaseAdmin } from "@/lib/supabase-server";
+import type { PasskeyView } from "./types";
+
+// 패스키 표(passkey_credentials, passkey_registration_challenges)를 읽고 쓰는 곳.
+// 서버 전용 키(SUPABASE_SECRET_KEY)로 접근하므로 RLS가 적용되지 않는다. (db/README.md 참고)
+// 그래서 "이 사용자의 것인가"는 아래 함수들이 사용자 id 조건을 직접 거는 것으로 지킨다.
+// 사용자 id 는 항상 호출하는 쪽이 requireUser() 로 확인한 값이어야 하고, 요청 본문에서 받은 값을 넘기지 않는다.
+
+type DbError = { code?: string; message?: string } | null;
+
+// 응답으로 내보내도 되는 열. credential_id, public_key, counter 는 화면이 쓸 일이 없어서 내보내지 않는다.
+const VIEW_COLUMNS = "id, name, created_at, last_used_at, device_type, backed_up, aaguid, transports";
+
+export async function listPasskeys(userId: string): Promise<{ data: PasskeyView[] | null; error: DbError }> {
+  const { data, error } = await getSupabaseAdmin()
+    .from("passkey_credentials")
+    .select(VIEW_COLUMNS)
+    .eq("user_id", userId)
+    .order("created_at", { ascending: true });
+
+  return { data: data as PasskeyView[] | null, error };
+}
+
+// 같은 인증기에 같은 계정의 패스키를 두 번 만들지 않도록, 등록 옵션의 excludeCredentials 에 넣을 목록
+export async function listCredentialRefs(
+  userId: string
+): Promise<{ data: { credential_id: string; transports: string[] }[] | null; error: DbError }> {
+  const { data, error } = await getSupabaseAdmin()
+    .from("passkey_credentials")
+    .select("credential_id, transports")
+    .eq("user_id", userId);
+
+  return { data, error };
+}
+
+// 등록용 챌린지를 저장한다. 사용자·표시 이름과 묶이고 만료 시각은 DB가 정한다.
+export async function createRegistrationChallenge(
+  userId: string,
+  challenge: string,
+  name: string
+): Promise<{ data: { challenge_id: string; expires_at: string } | null; error: DbError }> {
+  const { data, error } = await getSupabaseAdmin().rpc("create_registration_challenge", {
+    p_user_id: userId,
+    p_challenge: challenge,
+    p_name: name,
+  });
+
+  const row = Array.isArray(data) ? data[0] : null;
+
+  return {
+    data: row ? { challenge_id: row.challenge_id, expires_at: row.challenge_expires_at } : null,
+    error,
+  };
+}
+
+// 챌린지를 "쓴 것"으로 표시하면서 내용을 가져온다. UPDATE 한 문장이라 동시에 여러 요청이 와도 한 요청만 값을 받는다.
+// 없는 id, 남의 챌린지, 이미 쓴 것, 만료된 것은 모두 data 가 null 이다. (이유를 구분하지 않는다)
+export async function consumeRegistrationChallenge(
+  challengeId: string,
+  userId: string
+): Promise<{ data: { challenge: string; name: string } | null; error: DbError }> {
+  const { data, error } = await getSupabaseAdmin().rpc("consume_registration_challenge", {
+    p_challenge_id: challengeId,
+    p_user_id: userId,
+  });
+
+  const row = Array.isArray(data) ? data[0] : null;
+
+  return {
+    data: row ? { challenge: row.challenge_value, name: row.credential_name } : null,
+    error,
+  };
+}
+
+export type NewPasskey = {
+  userId: string;
+  credentialId: string;
+  publicKey: string;
+  counter: number;
+  transports: string[];
+  deviceType: "singleDevice" | "multiDevice";
+  backedUp: boolean;
+  aaguid: string | null;
+  name: string;
+};
+
+// 서버가 등록 결과를 검증한 뒤에만 부른다. 같은 credential_id 는 DB의 고유 제약이 막는다. (오류 코드 23505)
+export async function insertPasskey(input: NewPasskey): Promise<{ data: PasskeyView | null; error: DbError }> {
+  const { data, error } = await getSupabaseAdmin()
+    .from("passkey_credentials")
+    .insert({
+      user_id: input.userId,
+      credential_id: input.credentialId,
+      public_key: input.publicKey,
+      counter: input.counter,
+      transports: input.transports,
+      device_type: input.deviceType,
+      backed_up: input.backedUp,
+      aaguid: input.aaguid,
+      name: input.name,
+    })
+    .select(VIEW_COLUMNS)
+    .single();
+
+  return { data: data as PasskeyView | null, error };
+}
